# Kopie als .env.local anlegen und Werte eintragen. .env.local wird nicht committet.
# In Vercel dieselben Variablen unter Settings → Environment Variables hinterlegen
# (Production + Preview; NEXT_PUBLIC_-Werte dürfen auch im Client landen, alle anderen nicht).

# --- Sanity ---
NEXT_PUBLIC_SANITY_PROJECT_ID=wsj8a3ho
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
# Token mit Viewer-Rechten für Drafts/Preview; Editor-Rechte nur, wenn Skripte schreiben müssen. Nur serverseitig verwenden.
SANITY_API_TOKEN=
# Zufälliger String, schützt die Revalidate-Route (Sanity Webhook → /api/revalidate)
SANITY_REVALIDATE_SECRET=

# --- Formulare (nur serverseitig) ---
# 32+ Zufallszeichen, pro Umgebung verschieden; signiert den Zeitstempel im Formular (Spam-Schutz)
FORM_SIGNING_SECRET=
# Rate-Limit-Speicher (Upstash Redis über Vercel Marketplace). Leer = In-Memory-Fallback, nur lokal/Preview.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- SendGrid (nur serverseitig) ---
SENDGRID_API_KEY=
# Absender muss in SendGrid verifiziert sein (Single Sender oder Domain Authentication für golfnext.de)
SENDGRID_FROM_EMAIL=website@golfnext.de
SENDGRID_FROM_NAME=GolfNext Website
# Empfänger der Formular-Mails
CONTACT_TO_EMAIL=info@golfnext.de

# --- Nur für Testläufe, NIEMALS in Production setzen ---
# MAIL_TRANSPORT=mock     erzwingt den Mock-Transport (schreibt nach test-results/mail/),
#                         auch wenn SENDGRID_API_KEY gesetzt ist.
# RATELIMIT_STORE=memory  erzwingt den In-Memory-Speicher statt Upstash Redis.
# Beide setzt playwright.config.ts selbst – hier stehen sie nur zur Erklärung.

# --- Website ---
NEXT_PUBLIC_SITE_URL=https://www.golfnext.de
# Buchungslink für das Online-Erstgespräch (bestehender Buchungsweg, keinen neuen erfinden)
NEXT_PUBLIC_BOOKING_URL=

# --- Tracking (erst nach Consent geladen, siehe docs/05-consent-dsgvo.md) ---
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
